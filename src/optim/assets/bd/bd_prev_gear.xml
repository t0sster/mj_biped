<mujoco model="BD-prev-gear">
    <compiler angle="radian" meshdir="meshes" autolimits="true"/>
    <option timestep="0.005" solver="Newton" integrator="RK4"/>

    <default>
        <default class="BD-prims">
            <site group="5" rgba="1 0 0 1"/>

            <default class="visual">
                <geom group="2" type="capsule" size="0.02 0.05" density="0" contype="0" conaffinity="0"/>
            </default>
            <default class="collision">
                <geom group="3" rgba=".2 .6 .2 .3" type="capsule" contype="1" conaffinity="1"/>
            </default>
            
            <default class="foot_properties">
                <geom contype="1" conaffinity="1" friction="1.0 0.005 0.0001" condim="4" rgba="0.5 1 1 1"/>
            </default>

            <default class="motor_J8006_visual">
                <geom group="2" type="cylinder" size="0.048 0.02" density="0" contype="0" conaffinity="0" rgba="0.1 0.7 0.3 1"/>
            </default>
            <default class="motor_J8006_collision">
                <geom group="3"  type="cylinder" size="0.048 0.02" contype="1" conaffinity="1" rgba=".2 .6 .2 .3"/>
            </default>

            <default class="motor_J6006_visual">
                <geom group="2" type="cylinder" size="0.038 0.018" density="0" contype="0" conaffinity="0" rgba="0.3 0.7 0.3 1"/>
            </default>
            <default class="motor_J6006_collision">
                <geom group="3" type="cylinder" size="0.038 0.018" contype="1" conaffinity="1" rgba=".2 .6 .2 .3"/>
            </default>

            <default class="motor_J">
                <general gaintype="fixed" gainprm="1" biastype="affine" biasprm="0 0 0" />
            </default>
        </default>
    </default>

    <asset>
        <texture type="2d" name="grid_tex" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="100" height="100"/>
        <material name="grid" texture="grid_tex" texrepeat="1 1" texuniform="true"/>
    </asset>

    <worldbody>

        <!-- <geom name="floor" pos="0 0 -0.6" size="0 0 0.05" type="plane" material="grid" condim="3" friction="0.95 0.005 0.0001"/> -->

        <body name="pelvis" pos="0 0 0" childclass="BD-prims">
            <light pos="0 0 2" mode="trackcom" castshadow="false"/>
            <inertial pos="0 0 0" quat="1 0 0 0" mass="2.0" diaginertia="0.01 0.01 0.01"/>
            <freejoint name="floating_base"/>
            <geom class="visual" type="capsule" size="0.05 0.05" euler="1.57 0 0" rgba="0.1 0.5 0.5 1"/>
            <geom class="collision" type="capsule" size="0.05 0.05" euler="1.57 0 0"/>

            <body name="waist" pos="0 0 0.05">
                <geom class="visual" type="cylinder" size="0.03 0.05"/>
                <body name="head" pos="0 0 0.1">
                    <geom class="visual" type="sphere" size="0.1" rgba="1 0.1 0.1 1"/>
                    <geom class="collision" type="sphere" size="0.1"/>
                    <inertial pos="0 0 0" mass="1.5" diaginertia="0.001 0.001 0.001"/>
                    <geom class="visual" type="cylinder" pos="0 0 -0.03" size="0.1 0.03" rgba="1 0.1 0.1 1"/>
                    <geom class="visual" type="sphere" pos="0.075 0 0.03" size="0.03" rgba="0.05 0.05 0.05 1"/>
                </body>
            </body>

            <body name="left_hip_pitch_motor" pos="0 0.08 0">
                <geom class="motor_J8006_visual"  euler="-1.57 0 0"/>
                <geom class="motor_J8006_collision"  euler="-1.57 0 0"/>
                <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
            </body>
            <body name="left_hip_pitch_link" pos="0 0.08 0">
                <joint name="JL0_hip_pitch" axis="0 1 0" range="-1.57 1.57" armature="0.0020465" damping="0.2"/>
                <!-- <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/> -->
                <geom class="motor_J8006_visual" pos="0 0.08 0" euler="0 1.57 0"/>
                <geom class="motor_J8006_collision" pos="0 0.08 0" euler="0 1.57 0"/>
                <inertial pos="0 0.08 0" mass="0.55" diaginertia="0.0007 0.001 0.001"/>
                
                <body name="left_hip_roll_link" pos="0 0.08 0">
                    <joint name="JL1_hip_roll" axis="1 0 0" range="-0.785 1.57" armature="0.0020465" damping="0.2"/>
                    <geom class="visual" type="box" pos="0 0 -0.05" size="0.01 0.03 0.05"/>
                    <geom class="motor_J6006_visual" pos="0 0 -0.1" euler="3.14 0 0"/>
                    <geom class="motor_J6006_collision" pos="0 0 -0.1" euler="3.14 0 0"/>
                    <inertial pos="0 0 -0.1" mass="0.55" diaginertia="0.001 0.001 0.0007"/>

                    <body name="left_thigh_yaw_link" pos="0 0 -0.1">
                        <joint name="JL2_thigh_yaw" axis="0 0 -1" range="-1.57 1.57" armature="0.0020465" damping="0.2"/>
                        
                        <geom class="visual" type="cylinder" pos="0 -0.005 -0.08" size="0.015 0.005" euler="1.57 0 0" rgba="0.8 0.2 0.2 1"/>
                        <geom class="visual" type="cylinder" pos="0 -0.005 -0.16" size="0.03 0.005" euler="1.57 0 0" rgba="0.8 0.2 0.2 1"/>
                        <geom class="motor_J8006_visual" euler="-1.57 0 0" pos="0 0.02 -0.08"/>
                        <geom class="motor_J8006_collision" euler="-1.57 0 0" pos="0 0.02 -0.08"/>
                        <inertial pos="0 0.02 -0.08" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                        <body name="left_thigh_struc" pos="0 0 0">
                            <geom class="visual" type="box" pos="0 0 -0.1" size="0.03 0.005 0.08" mass="0.1" rgba="0.2 0.2 0.8 1"/>
                            <geom class="visual" type="box" pos="0 -0.025 -0.1" size="0.02 0.005 0.08" mass="0.1" rgba="0.2 0.2 0.8 1"/>
                        </body>
                        
                        <body name="left_knee_pitch_link" pos="0 -0.015 -0.16">
                            <joint name="JL3_knee_pitch" axis="0 -1 0" range="-1.57 2.62" armature="0.0020465" damping="0.2"/>
                            <geom class="motor_J6006_visual" euler="1.57 0 0" pos="0 0.02 -0.22"/>
                            <geom class="motor_J6006_collision" euler="1.57 0 0" pos="0 0.02 -0.22"/>
                            <inertial pos="0 0.02 -0.22" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                            <body name="left_knee_struc" pos="0 0 0">
                                <geom class="visual" type="box" pos="0 0 -0.11" size="0.02 0.005 0.11" mass="0.1" rgba="0.2 0.4 0.9 1"/>
                            </body>

                            <body name="left_ankle_pitch_link" pos="0 0 -0.22">
                                <joint name="JL4_ankle_pitch" axis="0 -1 0" range="-1.57 0.785" armature="0.0020465" damping="0.2"/>
                                <!-- <geom class="foot" pos="0.015 0 -0.055" rgba="0.2 0.3 0.7 1"/> -->
                                <body name="left_foot" pos="0 0 -0.055" childclass="foot_properties">
                                    <geom type="box" pos="0.06 0.02 0" size="0.01 0.015 0.005"/>
                                    <geom type="box" pos="0.06 -0.02 0" size="0.01 0.015 0.005"/>
                                    <geom type="box" pos="0 0 0" size="0.04 0.015 0.005"/>
                                    <geom type="box" pos="-0.06 0 0" size="0.01 0.015 0.005"/>
                                </body>
                                <inertial pos="0.015 0 -0.055" mass="0.2" diaginertia="0.0001 0.0005 0.0005"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

            <body name="right_hip_pitch_motor" pos="0 -0.08 0">
                <geom class="motor_J8006_visual"  euler="-1.57 0 0"/>
                <geom class="motor_J8006_collision"  euler="-1.57 0 0"/>
                <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
            </body>
            <body name="right_hip_pitch_link" pos="0 -0.08 0">
                <joint name="JR0_hip_pitch" axis="0 -1 0" range="-1.57 1.57" armature="0.0020465" damping="0.2"/>
                <!-- <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/> -->
                <geom class="motor_J8006_visual" euler="0 1.57 0" pos="0 -0.08 0"/>
                <geom class="motor_J8006_collision" euler="0 1.57 0" pos="0 -0.08 0"/>
                <inertial pos="0 -0.08 0" mass="0.55" diaginertia="0.0007 0.001 0.001"/>

                <body name="right_hip_roll_link" pos="0 -0.08 0">
                    <joint name="JR1_hip_roll" axis="1 0 0" range="-0.785 1.57" armature="0.0020465" damping="0.2"/>
                    <geom class="visual" type="box" pos="0 0 -0.05" size="0.01 0.03 0.05"/>
                    <geom class="motor_J6006_visual" pos="0 0 -0.1" euler="3.14 0 0"/>
                    <geom class="motor_J6006_collision" pos="0 0 -0.1" euler="3.14 0 0"/>
                    <inertial pos="0 0 -0.1" mass="0.55" diaginertia="0.001 0.001 0.0007"/>

                    <body name="right_thigh_yaw_link" pos="0 0 -0.1">
                        <joint name="JR2_thigh_yaw" axis="0 0 -1" range="-1.57 1.57" armature="0.0020465" damping="0.2"/>                     
                        <geom class="visual" type="cylinder" pos="0 0.005 -0.08" size="0.015 0.005" euler="1.57 0 0" rgba="0.8 0.2 0.2 1"/>
                        <geom class="visual" type="cylinder" pos="0 0.005 -0.16" size="0.03 0.005" euler="1.57 0 0" rgba="0.8 0.2 0.2 1"/>
                        <geom class="motor_J8006_visual" euler="-1.57 0 0" pos="0 -0.02 -0.08"/>
                        <geom class="motor_J8006_collision" euler="-1.57 0 0" pos="0 -0.02 -0.08"/>
                        <inertial pos="0 -0.02 -0.08" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                        <body name="right_thigh_struc" pos="0 0 0">
                            <geom class="visual" type="box" pos="0 0 -0.1" size="0.03 0.005 0.08" mass="0.1" rgba="0.2 0.2 0.8 1"/>
                            <geom class="visual" type="box" pos="0 0.025 -0.1" size="0.02 0.005 0.08" mass="0.1" rgba="0.2 0.2 0.8 1"/>
                        </body>

                        <body name="right_knee_pitch_link" pos="0 0.015 -0.16">
                            <joint name="JR3_knee_pitch" axis="0 1 0" range="-2.62 1.57" armature="0.0020465" damping="0.2"/>
                            <geom class="motor_J6006_visual" pos="0 -0.02 -0.22" euler="1.57 0 0"/>
                            <geom class="motor_J6006_collision" pos="0 -0.02 -0.22" euler="1.57 0 0"/>
                            <inertial pos="0 -0.02 -0.22" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                            <body name="right_knee_struc" pos="0 0 0">
                                <geom class="visual" type="box" pos="0 0 -0.11" size="0.02 0.005 0.11" mass="0.1" rgba="0.2 0.4 0.9 1"/>
                            </body>

                            <body name="right_ankle_pitch_link" pos="0 0 -0.22">
                                <joint name="JR4_ankle_pitch" axis="0 1 0" range="-0.785 1.31" armature="0.0020465" damping="0.2"/>
                                <!-- <geom class="foot" pos="0.015 0 -0.055" rgba="0.2 0.3 0.7 1"/> -->
                                <body name="right_foot" pos="0 0 -0.055" childclass="foot_properties">
                                    <geom type="box" pos="0.06 0.02 0" size="0.01 0.015 0.005"/>
                                    <geom type="box" pos="0.06 -0.02 0" size="0.01 0.015 0.005"/>
                                    <geom type="box" pos="0 0 0" size="0.04 0.015 0.005"/>
                                    <geom type="box" pos="-0.06 0 0" size="0.01 0.015 0.005"/>
                                </body>
                                <inertial pos="0.015 0 -0.055" mass="0.2" diaginertia="0.0001 0.0005 0.0005"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

        </body>
    </worldbody>

    <actuator>
        <motor name="ML0_hip_pitch"     class="motor_J"   joint="JL0_hip_pitch"   gear="1" forcerange="-20 20" ctrlrange="-20 20"/>
        <motor name="ML1_hip_roll"      class="motor_J"   joint="JL1_hip_roll"    gear="1" forcerange="-20 20" ctrlrange="-20 20"/>
        <motor name="ML2_thigh_yaw"     class="motor_J"   joint="JL2_thigh_yaw"   gear="1" forcerange="-12 12" ctrlrange="-12 12"/>
        <motor name="ML3_knee_pitch"    class="motor_J"   joint="JL3_knee_pitch"  gear="1" forcerange="-20 20" ctrlrange="-20 20"/>
        <motor name="ML4_ankle_pitch"   class="motor_J"   joint="JL4_ankle_pitch" gear="1" forcerange="-12 12" ctrlrange="-12 12"/>
        
        <motor name="MR0_hip_pitch"     class="motor_J"   joint="JR0_hip_pitch"   gear="1" forcerange="-20 20" ctrlrange="-20 20"/>
        <motor name="MR1_hip_roll"      class="motor_J"   joint="JR1_hip_roll"    gear="1" forcerange="-20 20" ctrlrange="-20 20"/>
        <motor name="MR2_thigh_yaw"     class="motor_J"   joint="JR2_thigh_yaw"   gear="1" forcerange="-12 12" ctrlrange="-12 12"/>
        <motor name="MR3_knee_pitch"    class="motor_J"   joint="JR3_knee_pitch"  gear="1" forcerange="-20 20" ctrlrange="-20 20"/>
        <motor name="MR4_ankle_pitch"   class="motor_J"   joint="JR4_ankle_pitch" gear="1" forcerange="-12 12" ctrlrange="-12 12"/>
    </actuator>
</mujoco>
