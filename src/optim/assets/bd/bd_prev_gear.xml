<mujoco model="BD-prev-gear">
    <compiler angle="radian" meshdir="meshes" autolimits="true"/>

    <default>
        <default class="BD-prims">
            <site group="5" rgba="1 0 0 1"/>

            <default class="visual">
                <geom group="2" type="capsule" size="0.02 0.05" density="0" contype="0" conaffinity="0"/>
            </default>
            <default class="collision">
                <geom group="3" rgba=".2 .6 .2 .3" type="capsule" contype="1" conaffinity="1"/>
            </default>
            
            <default class="foot_capsule">
                <geom type="capsule" pos="0.015 0 -0.055" size="0.02 0.06" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" condim="4" rgba="1 1 1 1" quat="0.7071 0 0.7071 0" />
            </default>

            <default class="motor_J8006_visual">
                <geom group="2" type="cylinder" size="0.048 0.02" density="0" contype="0" conaffinity="0" rgba="0.1 0.7 0.3 1"/>
            </default>
            <default class="motor_J8006_collision">
                <geom group="3"  type="cylinder" size="0.048 0.02" contype="1" conaffinity="1" rgba=".2 .6 .2 .3"/>
            </default>

            <default class="motor_J6006_visual">
                <geom group="2" type="cylinder" size="0.038 0.018" density="0" contype="0" conaffinity="0" rgba="0.3 0.7 0.3 1"/>
            </default>
            <default class="motor_J6006_collision">
                <geom group="3" type="cylinder" size="0.038 0.018" contype="1" conaffinity="1" rgba=".2 .6 .2 .3"/>
            </default>
        </default>
    </default>

    <asset>
        <texture type="2d" name="grid_tex" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="100" height="100"/>
        <material name="grid" texture="grid_tex" texrepeat="1 1" texuniform="true"/>
    </asset>

    <worldbody>
        <!-- <geom name="floor" pos="0 0 -0.6" size="0 0 0.05" type="plane" material="grid" condim="3" friction="0.95 0.005 0.0001"/> -->

        <body name="pelvis" pos="0 0 0" childclass="BD-prims">
            <light pos="0 0 2" mode="trackcom" castshadow="false"/>
            <inertial pos="0 0 0" quat="1 0 0 0" mass="2.0" diaginertia="0.01 0.01 0.01"/>
            <freejoint name="floating_base"/>
            <geom class="visual" type="capsule" size="0.05 0.05" euler="1.57 0 0" rgba="0.1 0.5 0.5 1"/>
            <geom class="collision" type="capsule" size="0.05 0.05" euler="1.57 0 0"/>

            <body name="waist" pos="0 0 0.05">
                <geom class="visual" type="cylinder" size="0.03 0.05"/>
                <body name="head" pos="0 0 0.1">
                    <geom class="visual" type="sphere" size="0.1" rgba="1 0.1 0.1 1"/>
                    <geom class="collision" type="sphere" size="0.1"/>
                    <inertial pos="0 0 0" mass="1.5" diaginertia="0.001 0.001 0.001"/>
                    <geom class="visual" type="cylinder" pos="0 0 -0.03" size="0.1 0.03" rgba="1 0.1 0.1 1"/>
                    <geom class="visual" type="sphere" pos="0.075 0 0.03" size="0.03" rgba="0.05 0.05 0.05 1"/>
                </body>
            </body>

            <body name="left_hip_pitch_link" pos="0 0.08 0">
                <joint name="JL0_hip_pitch" axis="0 1 0" range="-1.57 1.57" armature="5.68473e-05" damping="2.81723e-04"/>
                <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                <geom class="motor_J8006_visual" euler="-1.57 0 0"/>
                <geom class="motor_J8006_collision" euler="-1.57 0 0"/>
                
                <body name="left_hip_roll_link" pos="0 0.08 0">
                    <inertial pos="0 0 0" mass="0.55" diaginertia="0.0007 0.001 0.001"/>
                    <joint name="JL1_hip_roll" axis="1 0 0" range="-0.785 1.57" armature="5.68473e-05" damping="2.81723e-04"/>
                    <geom class="motor_J8006_visual" euler="0 1.57 0"/>
                    <geom class="motor_J8006_collision" euler="0 1.57 0"/>
                    <geom class="visual" type="box" pos="0 0 -0.05" size="0.01 0.03 0.05"/>

                    <body name="left_thigh_yaw_link" pos="0 0 -0.1">
                        <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.001 0.0007"/>
                        <joint name="JL2_thigh_yaw" axis="0 0 -1" range="-1.57 1.57" armature="5.68473e-05" damping="2.81723e-04"/>
                        <geom class="motor_J6006_visual" euler="3.14 0 0"/>
                        <geom class="motor_J6006_collision" euler="3.14 0 0"/>
                        <geom class="visual" type="box" pos="0 0 -0.08" size="0.03 0.005 0.08" rgba="0.2 0.2 0.8 1"/>
                        <geom class="visual" type="box" pos="0 -0.025 -0.1" size="0.02 0.005 0.08" rgba="0.2 0.2 0.8 1"/>

                        <geom class="motor_J8006_visual" euler="-1.57 0 0" pos="0 0.02 -0.08"/>
                        <geom class="motor_J8006_collision" euler="-1.57 0 0" pos="0 0.02 -0.08"/>
                        <geom class="visual" type="cylinder" pos="0 -0.005 -0.08" size="0.015 0.005" euler="1.57 0 0" rgba="0.8 0.2 0.2 1"/>
                        <geom class="visual" type="cylinder" pos="0 -0.005 -0.16" size="0.03 0.005" euler="1.57 0 0" rgba="0.8 0.2 0.2 1"/>

                        <body name="left_knee_pitch_link" pos="0 -0.015 -0.16">
                            <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                            <joint name="JL3_knee_pitch" axis="0 1 0" range="-3.14 1.57" armature="2.273892e-04" damping="1.126892e-03"/>
                            <geom class="visual" type="box" pos="0 0 -0.11" size="0.02 0.005 0.11"/>

                            <body name="left_ankle_pitch_link" pos="0 0 -0.22">
                                <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                                <joint name="JL4_ankle_pitch" axis="0 -1 0" range="-1.57 0.785" armature="5.68473e-05" damping="2.81723e-04"/>
                                <geom class="motor_J6006_visual" euler="1.57 0 0" pos="0 0.02 0"/>
                                <geom class="motor_J6006_collision" euler="1.57 0 0" pos="0 0.02 0"/>
                                <geom class="foot_capsule" rgba="0.2 0.3 0.7 1"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

            <body name="right_hip_pitch_link" pos="0 -0.08 0">
                <joint name="JR0_hip_pitch" axis="0 -1 0" range="-1.57 1.57" armature="5.68473e-05" damping="2.81723e-04"/>
                <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                <geom class="motor_J8006_visual" euler="1.57 0 0"/>
                <geom class="motor_J8006_collision" euler="1.57 0 0"/>

                <body name="right_hip_roll_link" pos="0 -0.08 0">
                    <inertial pos="0 0 0" mass="0.55" diaginertia="0.0007 0.001 0.001"/>
                    <joint name="JR1_hip_roll" axis="1 0 0" range="-0.785 1.57" armature="5.68473e-05" damping="2.81723e-04"/>
                    <geom class="motor_J8006_visual" euler="0 1.57 0"/>
                    <geom class="motor_J8006_collision" euler="0 1.57 0"/>
                    <geom class="visual" type="box" pos="0 0 -0.05" size="0.01 0.03 0.05"/>

                    <body name="right_thigh_yaw_link" pos="0 0 -0.1">
                        <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.001 0.0007"/>
                        <joint name="JR2_thigh_yaw" axis="0 0 -1" range="-1.57 1.57" armature="5.68473e-05" damping="2.81723e-04"/>
                        <geom class="motor_J6006_visual" euler="3.14 0 0"/>
                        <geom class="motor_J6006_collision" euler="3.14 0 0"/>
                        <geom class="visual" type="box" pos="0 0 -0.08" size="0.03 0.005 0.08" rgba="0.2 0.2 0.8 1"/>
                        <geom class="visual" type="box" pos="0 0.025 -0.1" size="0.02 0.005 0.08" rgba="0.2 0.2 0.8 1"/>

                        <geom class="motor_J8006_visual" euler="-1.57 0 0" pos="0 -0.02 -0.08"/>
                        <geom class="motor_J8006_collision" euler="-1.57 0 0" pos="0 -0.02 -0.08"/>
                        <geom class="visual" type="cylinder" pos="0 0.005 -0.08" size="0.015 0.005" euler="1.57 0 0" rgba="0.8 0.2 0.2 1"/>
                        <geom class="visual" type="cylinder" pos="0 0.005 -0.16" size="0.03 0.005" euler="1.57 0 0" rgba="0.8 0.2 0.2 1"/>

                        <body name="right_knee_pitch_link" pos="0 0.015 -0.16">
                            <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                            <joint name="JR3_knee_pitch" axis="0 -1 0" range="-1.57 3.14" armature="2.273892e-04" damping="1.126892e-03"/>
                            <geom class="visual" type="box" pos="0 0 -0.11" size="0.02 0.005 0.11"/>

                            <body name="right_ankle_pitch_link" pos="0 0 -0.22">
                                <inertial pos="0 0 0" mass="0.55" diaginertia="0.001 0.0007 0.001"/>
                                <joint name="JR4_ankle_pitch" axis="0 1 0" range="-0.785 1.57" armature="5.68473e-05" damping="2.81723e-04"/>
                                <geom class="motor_J6006_visual" euler="1.57 0 0" pos="0 -0.02 0"/>
                                <geom class="motor_J6006_collision" euler="1.57 0 0" pos="0 -0.02 0"/>
                                <geom class="foot_capsule" rgba="0.2 0.3 0.7 1"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

        </body>
    </worldbody>

    <actuator>
        <motor name="ML0_hip_pitch"     joint="JL0_hip_pitch"   gear="1" ctrlrange="-20 20"/>
        <motor name="ML1_hip_roll"      joint="JL1_hip_roll"    gear="1" ctrlrange="-20 20"/>
        <motor name="ML2_thigh_yaw"     joint="JL2_thigh_yaw"   gear="1" ctrlrange="-12 12"/>
        <motor name="ML3_knee_pitch"    joint="JL3_knee_pitch"  gear="2" ctrlrange="-20 20"/>
        <motor name="ML4_ankle_pitch"   joint="JL4_ankle_pitch" gear="1" ctrlrange="-12 12"/>
        
        <motor name="MR0_hip_pitch"     joint="JR0_hip_pitch"   gear="1" ctrlrange="-20 20"/>
        <motor name="MR1_hip_roll"      joint="JR1_hip_roll"    gear="1" ctrlrange="-20 20"/>
        <motor name="MR2_thigh_yaw"     joint="JR2_thigh_yaw"   gear="1" ctrlrange="-12 12"/>
        <motor name="MR3_knee_pitch"    joint="JR3_knee_pitch"  gear="2" ctrlrange="-20 20"/>
        <motor name="MR4_ankle_pitch"   joint="JR4_ankle_pitch" gear="1" ctrlrange="-12 12"/>
    </actuator>
</mujoco>
